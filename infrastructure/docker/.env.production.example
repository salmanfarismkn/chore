# Production Compose input only. Supply real values through a secret manager or
# an untracked environment file; never commit the populated file.
POSTGRES_USER=replace-with-database-user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=replace-with-database-name
DATABASE_URL=postgres://replace-with-user:replace-with-password@postgres:5432/replace-with-database-name
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://:replace-with-redis-password@redis:6379
APP_SESSION_TTL_SECONDS=3600
AUTH0_ISSUER=https://replace-with-auth0-tenant-domain/
AUTH0_CLIENT_IDS=replace-with-web-client-id,replace-with-mobile-client-id
AUTH0_WEB_CLIENT_ID=replace-with-web-client-id
AUTH0_NATIVE_CLIENT_ID=replace-with-mobile-client-id
AUTH0_WEB_REDIRECT_URIS=https://replace-with-web-callback.example/callback
AUTH0_NATIVE_REDIRECT_URIS=com.example.prontoplus://auth/callback
CORS_ORIGIN=https://replace-with-frontend-origin
TRUST_PROXY=replace-with-trusted-proxy-ip-or-cidr
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_BOOKING_MAX=20
RATE_LIMIT_BOOKING_WINDOW_MS=60000
RATE_LIMIT_ACCEPTANCE_MAX=30
RATE_LIMIT_ACCEPTANCE_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=10
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_SOCKET_MAX=60
RATE_LIMIT_SOCKET_WINDOW_MS=60000
BACKEND_PORT=3000
