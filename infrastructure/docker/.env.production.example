# Production Compose input only. Supply real values through a secret manager or
# an untracked environment file; never commit the populated file.
POSTGRES_USER=replace-with-database-user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=replace-with-database-name
DATABASE_URL=postgres://replace-with-user:replace-with-password@postgres:5432/replace-with-database-name
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://:replace-with-redis-password@redis:6379
JWT_SECRET=replace-with-a-random-production-secret-at-least-32-characters
CORS_ORIGIN=https://replace-with-frontend-origin
TRUST_PROXY=false
BACKEND_PORT=3000
