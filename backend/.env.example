# Development only. Copy to .env, replace the placeholders, and keep .env out of Git.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/pronto
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_BOOKING_MAX=20
RATE_LIMIT_BOOKING_WINDOW_MS=60000
RATE_LIMIT_ACCEPTANCE_MAX=30
RATE_LIMIT_ACCEPTANCE_WINDOW_MS=60000