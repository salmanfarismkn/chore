# Development only. Copy to .env, replace the placeholders, and keep .env out of Git.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/pronto
REDIS_URL=redis://localhost:6379
APP_SESSION_TTL_SECONDS=3600
# Optional local Auth0 settings. Configure distinct web/native client IDs and
# exact callback allowlists before using the authorization-code flow.
AUTH0_ISSUER=
AUTH0_CLIENT_IDS=
AUTH0_WEB_CLIENT_ID=
AUTH0_NATIVE_CLIENT_ID=
AUTH0_WEB_REDIRECT_URIS=
AUTH0_NATIVE_REDIRECT_URIS=
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_BOOKING_MAX=20
RATE_LIMIT_BOOKING_WINDOW_MS=60000
RATE_LIMIT_ACCEPTANCE_MAX=30
RATE_LIMIT_ACCEPTANCE_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=10
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_SOCKET_MAX=60
RATE_LIMIT_SOCKET_WINDOW_MS=60000